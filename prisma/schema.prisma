generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum RequestType {
  VOYAGE
  DEVIS
  JUNIOR
  CORPORATE
  SPIRITUEL
  CONTACT
}

enum RequestStatus {
  NOUVELLE
  EN_COURS
  CLIENT_CONTACTE
  TRAITEE
  ANNULEE
}

enum GalleryCategory {
  PHOTO
  VIDEO
  EVENEMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  alt       String   @default("")
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Experience {
  id          String   @id @default(cuid())
  slug        String   @unique
  title         String
  titleEn       String   @default("")
  subtitle      String
  subtitleEn    String   @default("")
  excerpt       String
  excerptEn     String   @default("")
  description   String   @db.Text
  descriptionEn String   @db.Text @default("")
  highlights    String[] @default([])
  highlightsEn  String[] @default([])
  imageUrl    String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      Offer[]
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title         String
  titleEn       String   @default("")
  excerpt       String
  excerptEn     String   @default("")
  description   String   @db.Text
  descriptionEn String   @db.Text @default("")
  highlights    String[] @default([])
  highlightsEn  String[] @default([])
  icon        String   @default("plane")
  imageUrl    String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name          String
  nameEn        String   @default("")
  region        String   @default("")
  regionEn      String   @default("")
  excerpt       String
  excerptEn     String   @default("")
  description   String   @db.Text
  descriptionEn String   @db.Text @default("")
  imageUrl    String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      Offer[]
}

model Offer {
  id               String       @id @default(cuid())
  slug             String       @unique
  title              String
  titleEn            String       @default("")
  destinationLabel   String
  destinationLabelEn String       @default("")
  excerpt            String
  excerptEn          String       @default("")
  description        String       @db.Text
  descriptionEn      String       @db.Text @default("")
  priceFrom          Int?
  badge              String       @default("")
  badgeEn            String       @default("")
  imageUrl         String       @default("")
  featured         Boolean      @default(false)
  published        Boolean      @default(true)
  sortOrder        Int          @default(0)
  destinationId    String?
  destination      Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  experienceId     String?
  experience       Experience?  @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  titleEn     String    @default("")
  excerpt     String
  excerptEn   String    @default("")
  content     String    @db.Text
  contentEn   String    @db.Text @default("")
  imageUrl    String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  location   String   @default("")
  content    String   @db.Text
  contentEn  String   @db.Text @default("")
  rating     Int      @default(5)
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question   String
  questionEn String   @default("")
  answer     String   @db.Text
  answerEn   String   @db.Text @default("")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String          @id @default(cuid())
  title     String
  titleEn   String          @default("")
  caption   String          @default("")
  captionEn String          @default("")
  category  GalleryCategory @default(PHOTO)
  imageUrl  String
  mediaId   String?
  published Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TravelRequest {
  id          String        @id @default(cuid())
  reference   String        @unique
  type        RequestType
  status      RequestStatus @default(NOUVELLE)
  fullName    String
  email       String        @default("")
  phone       String
  destination String        @default("")
  travelDate  String        @default("")
  travelers   Int?
  message     String        @db.Text
  details     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
